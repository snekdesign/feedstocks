--- a/crates/tombi-schema-store/src/http_client/reqwest_client.rs
+++ b/crates/tombi-schema-store/src/http_client/reqwest_client.rs
@@ -65,8 +65,18 @@
         // store's stale-cache handling. Follow GET redirects here so a policy
         // refusal remains a typed, terminal error.
         for _ in 0..10 {
-            let response = client
-                .get(current_url.clone())
+            let builder = if let Some(suffix) = current_url.as_str().strip_prefix("https://raw.githubusercontent.com/") {
+                let mut v: Vec<&str> = suffix.split('/').collect();
+                let reference = v[2];
+                v[2] = "contents";
+                let path = v.join("/");
+                client.get(format!("https://api.github.com/repos/{path}?ref={reference}"))
+                      .header("Accept", "application/vnd.github.raw+json")
+                      .header("X-GitHub-Api-Version", "2026-03-10")
+            } else {
+                client.get(current_url.clone())
+            };
+            let response = builder
                 .send()
                 .await
                 .map_err(fetch_error_from_reqwest)?;
