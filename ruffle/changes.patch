@@ -186,6 +187,30 @@
     subscriber.init();

     let result = App::new(preferences).and_then(|(mut app, event_loop)| {
+        match CpuInfo::detect() {
+            Ok(info) => {
+                let mut p_cores: Vec<_> = info.lps.iter()
+                    .filter(|lp| lp.kind == CoreKind::Performance && lp.smt_index == 0)
+                    .collect();
+
+                p_cores.sort_by_key(|lp| std::cmp::Reverse(lp.perf_hint));
+
+                if let Some(best) = p_cores.first() {
+                    let _ = pin_thread_to_core(best.os_id as usize);
+                    match set_thread_priority(ThreadPriority::Highest) {
+                        Ok(applied) => {
+                            tracing::info!("render priority: {applied}");
+                        }
+                        Err(err) => {
+                            tracing::warn!("Failed to set thread priority: {err}");
+                        }
+                    }
+                }
+            }
+            Err(err) => {
+                tracing::warn!("Failed to retrieve cpuinfo: {err}");
+            }
+        }
         event_loop.run_app(&mut app).context("Event loop failure")
     });

